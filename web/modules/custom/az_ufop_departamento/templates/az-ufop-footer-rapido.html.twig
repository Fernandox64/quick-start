{#
/**
 * @file
 * Rodape com links rapidos (mesmos do menu principal) e redes sociais.
 *
 * Variaveis:
 * - links: lista de {title, url}.
 * - redes: mapa rede => url (facebook, instagram, twitter, youtube).
 */
#}
{% set icones = {
  facebook: '<path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8v-1.8c0-.8.2-1.3 1.4-1.3h1.5V5.4c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.6v2h-2.4v2.8h2.4V21h2.8z"/>',
  instagram: '<path d="M12 8.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8zm0 5.6a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4zM16.3 5H7.7A2.7 2.7 0 0 0 5 7.7v8.6A2.7 2.7 0 0 0 7.7 19h8.6a2.7 2.7 0 0 0 2.7-2.7V7.7A2.7 2.7 0 0 0 16.3 5zm1.5 11.3c0 .8-.7 1.5-1.5 1.5H7.7c-.8 0-1.5-.7-1.5-1.5V7.7c0-.8.7-1.5 1.5-1.5h8.6c.8 0 1.5.7 1.5 1.5v8.6zM16.4 7.9a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8z"/>',
  twitter: '<path d="M19 7.3c-.5.2-1 .4-1.6.5.6-.3 1-.9 1.2-1.5-.5.3-1.1.6-1.8.7A2.8 2.8 0 0 0 12 9.2c0 .2 0 .4.1.6-2.3-.1-4.4-1.2-5.7-2.9-.2.4-.4.9-.4 1.4 0 .9.5 1.8 1.2 2.2-.4 0-.8-.1-1.2-.3v.1c0 1.4 1 2.5 2.2 2.8-.2.1-.5.1-.8.1l-.6-.1c.4 1.1 1.5 1.9 2.7 2a5.6 5.6 0 0 1-3.5 1.2H5.4A7.9 7.9 0 0 0 9.7 17c5.1 0 7.9-4.3 7.9-8v-.4c.5-.4 1-.9 1.4-1.4z"/>',
  youtube: '<path d="M20.5 8.2s-.2-1.4-.8-2c-.7-.8-1.6-.8-2-.9C15 5 12 5 12 5h0s-3 0-5.7.3c-.4.1-1.3.1-2 .9-.6.6-.8 2-.8 2S3.3 9.9 3.3 11.6v1.5c0 1.7.2 3.4.2 3.4s.2 1.4.8 2c.7.8 1.7.8 2.2.9 1.6.1 6.5.3 6.5.3s3 0 5.7-.3c.4 0 1.3-.1 2-.9.6-.6.8-2 .8-2s.2-1.7.2-3.4v-1.5c0-1.7-.2-3.4-.2-3.4zM10 14.7V9.3l4.7 2.7-4.7 2.7z"/>',
} %}

<div class="col-12 col-md-6 col-lg-5">
  <h3 class="footer-title">{{ 'Acesso rápido'|t }}</h3>
  <div class="az-ufop-footer-links">
    <ul>
      {% for link in links %}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
</div>
{% if redes %}
<div class="col-12 col-md-6 col-lg-3">
  <h3 class="footer-title">{{ 'Siga-nos'|t }}</h3>
  <ul class="az-ufop-social-links">
    {% for rede, url in redes %}
      <li>
        <a href="{{ url }}" target="_blank" rel="noopener" aria-label="{{ rede }}">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">{{ icones[rede]|raw }}</svg>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
{% endif %}
