<?php

/**
 * @file
 * Hooks do modulo az_ufop_departamento.
 */

/**
 * Implements hook_page_attachments().
 *
 * Carrega o CSS que retinta o tema az_barrio para o vinho institucional da
 * UFOP em todo o site (ver css/az-ufop-tema.css).
 */
function az_ufop_departamento_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'az_ufop_departamento/tema';
}

/**
 * Implements hook_system_breadcrumb_alter().
 *
 * O link "Home" da breadcrumb (PathBasedBreadcrumbBuilder::build(), core)
 * usa t('Home') normalmente, e a tradução pt-br existe no banco - mas por
 * algum motivo (cache de traducao? negociacao de idioma nesse ponto do
 * bootstrap?) continua saindo em ingles em requisicoes reais, mesmo depois
 * de cache:rebuild. Troca direto aqui, sem depender do sistema de
 * traducao, pra garantir.
 */
function az_ufop_departamento_system_breadcrumb_alter(\Drupal\Core\Breadcrumb\Breadcrumb $breadcrumb, \Drupal\Core\Routing\RouteMatchInterface $route_match, array $context): void {
  foreach ($breadcrumb->getLinks() as $link) {
    if ($link->getText() === 'Home') {
      $link->setText('Início');
    }
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * O widget de calendario do filtro de eventos (az_event/az_calendar_filter)
 * tem os botoes "Today/This Week/This Month" e os nomes de mes/dia do
 * datepicker escritos direto no JS, sem passar por Drupal.t() - o pacote de
 * traducao pt-br nunca alcanca isso. Troca pelo arquivo traduzido deste
 * modulo (mesma logica, so os textos em pt-br) em vez de editar o profile
 * az_quickstart diretamente.
 */
function az_ufop_departamento_library_info_alter(array &$libraries, string $extension): void {
  if ($extension === 'az_event' && isset($libraries['az_calendar_filter']['js']['js/az_calendar_filter.js'])) {
    $options = $libraries['az_calendar_filter']['js']['js/az_calendar_filter.js'];
    unset($libraries['az_calendar_filter']['js']['js/az_calendar_filter.js']);
    // Caminho comecando com "/" e resolvido a partir da raiz do site (nao
    // do diretorio do az_event) - assim referencia o arquivo do nosso
    // proprio modulo sem precisar contar "../" ate a raiz.
    $path = '/' . \Drupal::service('extension.list.module')->getPath('az_ufop_departamento') . '/js/az-calendar-filter-pt-br.js';
    $libraries['az_calendar_filter']['js'][$path] = $options;
  }
}

/**
 * Implements hook_theme().
 */
function az_ufop_departamento_theme(): array {
  return [
    'az_ufop_noticias_carousel' => [
      'variables' => ['slides' => []],
      'template' => 'az-ufop-noticias-carousel',
    ],
    'az_ufop_footer_acesso_rapido' => [
      'variables' => ['links' => [], 'redes' => []],
      'template' => 'az-ufop-footer-rapido',
    ],
    'az_ufop_tutorial' => [
      'variables' => [],
      'template' => 'az-ufop-tutorial',
    ],
  ];
}

/**
 * Implements hook_theme_registry_alter().
 *
 * O az_barrio deixa "Search"/"Menu"/"Home"/"Close"/"Back to top" (menu
 * mobile offcanvas) escritos direto no Twig, sem passar por t(), entao o
 * pacote de traducao nunca os alcanca. Aponta o hook 'page' - e todas as
 * suas variantes de sugestao que ainda usam o template base (page__front,
 * page__node__az_flexible_page etc., uma por bundle de conteudo) - para
 * uma copia do template dentro deste modulo (mesmo padrao de um subtema)
 * com essas strings envolvidas em |t, para nao precisar editar o
 * tema/profile diretamente.
 *
 * Tambem aponta o hook 'block__system_branding_block' pra uma copia local
 * que inclui a logo oficial da UFOP antes da logo/nome do departamento no
 * cabecalho (mesmo padrao ja usado no rodape).
 */
function az_ufop_departamento_theme_registry_alter(array &$theme_registry): void {
  $path = \Drupal::service('extension.list.module')->getPath('az_ufop_departamento') . '/templates';
  foreach ($theme_registry as $hook => $info) {
    if ($hook === 'page' || (str_starts_with($hook, 'page__') && ($info['template'] ?? NULL) === 'page')) {
      $theme_registry[$hook]['path'] = $path;
      $theme_registry[$hook]['theme_path'] = 'az_ufop_departamento';
    }
    if ($hook === 'block__system_branding_block') {
      $theme_registry[$hook]['path'] = $path;
      $theme_registry[$hook]['theme_path'] = 'az_ufop_departamento';
    }
  }
}

/**
 * Implements hook_ENTITY_TYPE_view_alter() for node.
 *
 * O texto "Read more" do az_news e montado em az_core_canonical_summary_link_title()
 * como uma string PHP literal (nunca passa por t()), entao tambem fica fora
 * do alcance do pacote de traducao. Troca o texto renderizado quando a
 * noticia nao tem titulo de link customizado (caso em que o texto e sempre
 * "Read more").
 */
function az_ufop_departamento_node_view_alter(array &$build, \Drupal\Core\Entity\EntityInterface $entity, $display): void {
  if (isset($build['az_news_read_more'][0]['#markup']) && $build['az_news_read_more'][0]['#markup'] === 'Read more') {
    $build['az_news_read_more'][0]['#markup'] = t('Read more')->render();
  }
}
