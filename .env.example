# Copie para ".env" antes de subir (docker compose le esse arquivo sozinho).
# NUNCA commite o ".env" de verdade - so este ".example" vai pro git.

HOST_PORT=8198

# Multisite de demonstracao (departamentos extra, ver README).
DFIS_PORT=8299
DEMAT_PORT=8399
DEMED_PORT=8499
DEFIL_PORT=8599
DELET_PORT=8699
DEPRO_PORT=8799
DEMET_PORT=8899
DESOC_PORT=8999
DEQUI_PORT=9099
DECOM_PORT=9199
DECIVIL_PORT=9299
DEELET_PORT=9399

DB_NAME=db
DB_USER=db
DB_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-tambem

# Gere um valor novo e unico para producao, ex.: openssl rand -base64 50
HASH_SALT=

# Dominio final do site (ex.: ^ufop\.exemplo\.com\.br$). Deixe vazio em teste.
TRUSTED_HOST_PATTERN=
